# Environment Variables Example
# Copy this file and fill in your values
# DO NOT commit actual credentials to the repository

# ============================================
# NEWS API (Required)
# ============================================
# Get your API key at https://newsapi.org/register

NEWS_API_KEY=344e0a0ca5fb4898aaa44edd24855f29

# ============================================
# CLOUDINARY (Required)
# ============================================
# Create a free account at https://cloudinary.com

CLOUDINARY_CLOUD_NAME=dgi3u8chm
CLOUDINARY_UPLOAD_PRESET=xg3gxg9w

# ============================================
# ENVIRONMENT (Optional)
# ============================================
# Values: development, production

ENV=development

# ============================================
# FIREBASE (Optional - handled by firebase_options.dart)
# ============================================
# These are optional overrides. Firebase config is primarily
# handled by running `flutterfire configure` which generates
# lib/firebase_options.dart

FIREBASE_ANDROID_API_KEY=AIzaSyBkvDJ4f5hCMkyU8lmHGuPB9bWvfuTx5CI
FIREBASE_IOS_API_KEY=AIzaSyBFujKUREmgMmwrwhcCvVcvs064ab1ds_c

