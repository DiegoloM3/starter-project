rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Community articles: anyone can read; tracer bullet allows any write.
    // Strict ownership rules will be re-enabled in spec 002 final pass once
    // Firebase Auth is wired in the app.
    match /articles/{articleId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
