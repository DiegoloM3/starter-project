# OS
.DS_Store
Thumbs.db

# Editors / IDEs
# Ignore everything under .vscode/ except the launch config — sharing it
# lets any reviewer cloning the repo press F5 with the right
# --dart-define-from-file=keys.local.json wiring (see SOLUCION.md §13.6).
.vscode/*
!.vscode/launch.json
.idea/
*.iml

# Firebase
firebase-debug.log
firebase-debug.*.log
firestore-debug.log
ui-debug.log
.firebase/

# Misc local files
*.local
# Local copies of keys.json with real secrets. Committed template is
# frontend/keys.json; copy it to frontend/keys.local.json and replace the
# placeholder value. The Makefile (target `run`) picks up the .local copy
# automatically when present.
**/*.local.json
