rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    match /media/articles/{fileName} {
      allow read: if true;
      allow create: if isJournalist() && isNewFile() && isImage() && isSmallerThanMegabytes(5);
      allow update, delete: if false;
    }

    // The role is a custom claim that only the Admin SDK can set.
    function isJournalist() {
      return request.auth != null && request.auth.token.get('role', '') == 'journalist';
    }

    // Prevents overwriting an existing thumbnail.
    function isNewFile() {
      return resource == null;
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    function isSmallerThanMegabytes(megabytes) {
      return request.resource.size < megabytes * 1024 * 1024;
    }
  }
}
