rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Article thumbnails and images embedded in article content.
    match /media/articles/{fileName} {
      allow read: if true;
      allow create: if isJournalist() && isNewFile() && isImageSmallerThanMegabytes(5);
      allow update, delete: if false;
    }

    match /media/users/{uid}/{fileName} {
      allow read: if true;
      allow create: if isSignedInAs(uid) && isImageSmallerThanMegabytes(5);
      allow update: if false;
      allow delete: if isSignedInAs(uid);
    }

    function isSignedInAs(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // The role is a custom claim that only the Admin SDK can set.
    function isJournalist() {
      return request.auth != null && request.auth.token.get('role', '') == 'journalist';
    }

    // Prevents overwriting an existing file.
    function isNewFile() {
      return resource == null;
    }

    function isImageSmallerThanMegabytes(megabytes) {
      return request.resource.contentType.matches('image/.*')
        && request.resource.size < megabytes * 1024 * 1024;
    }
  }
}
