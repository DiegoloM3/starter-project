rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Deny all by default — only matched paths below are accessible

    match /media/articles/{uid}/{articleId}/thumbnail {

      // Any authenticated user can view article thumbnails
      allow read: if request.auth != null;

      // Only the owning user can upload thumbnails
      // Validates: auth, ownership, MIME type, file size
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.contentType.matches('image/(jpeg|png|webp)')
                   && request.resource.size <= 5 * 1024 * 1024;

      // Only the owning user can delete their thumbnails
      allow delete: if request.auth != null
                    && request.auth.uid == uid;
    }
  }
}
