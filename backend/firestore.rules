rules_version = '2';

// Enforces the schema documented in docs/DB_SCHEMA.md.
service cloud.firestore {
  match /databases/{database}/documents {

    match /articles/{articleId} {
      allow get: if true;
      allow list: if isPaginatedQuery();
      allow create: if isAutoGeneratedId(articleId)
        && isValidNewArticle(articleId, request.resource.data);
      // Articles are immutable until the app has authentication (see DB_SCHEMA.md).
      allow update, delete: if false;
    }

    // ---------- Queries ----------

    function isPaginatedQuery() {
      return request.query.limit != null && request.query.limit <= 50;
    }

    // ---------- Article document ----------

    function isAutoGeneratedId(articleId) {
      return articleId.matches('[A-Za-z0-9]{20}');
    }

    function isValidNewArticle(articleId, article) {
      return hasExactlyArticleFields(article)
        && isNonBlankStringUpTo(article.title, 100)
        && isNonBlankStringUpTo(article.content, 10000)
        && isStringUpTo(article.description, 300)
        && isNonBlankStringUpTo(article.author, 60)
        && isThumbnailURLOfArticle(article.thumbnailURL, articleId)
        && article.publishedAt == request.time;
    }

    function hasExactlyArticleFields(article) {
      let fields = ['title', 'content', 'description', 'author', 'thumbnailURL', 'publishedAt'];
      return article.keys().hasAll(fields) && article.keys().hasOnly(fields);
    }

    // ---------- Field validators ----------

    function isStringUpTo(value, maxLength) {
      return value is string && value.size() <= maxLength;
    }

    function isNonBlankStringUpTo(value, maxLength) {
      return isStringUpTo(value, maxLength) && value.trim().size() > 0;
    }

    // Download URL of media/articles/{articleId}.{jpg|png|webp} in this project's bucket,
    // served by Cloud Storage or by a local Storage emulator (host machine or Android emulator).
    function isThumbnailURLOfArticle(url, articleId) {
      let storageHost = '(https://firebasestorage[.]googleapis[.]com|http://(127[.]0[.]0[.]1|localhost|10[.]0[.]2[.]2):9199)';
      let objectPath = '/v0/b/backend-news-symmetry[.]firebasestorage[.]app/o/media%2Farticles%2F' + articleId;
      let query = '[.](jpg|png|webp)[?]alt=media&token=[0-9a-f-]{36}';
      return url is string && url.matches(storageHost + objectPath + query);
    }
  }
}
